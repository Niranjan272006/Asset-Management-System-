{
  "gitignore": [
    "# =========================",
    "# React + Django + VS Code",
    "# =========================",

    "",

    "# ---------- React / Node ----------",
    "node_modules/",
    "build/",
    "dist/",
    ".next/",
    ".cache/",
    "coverage/",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",

    "",

    "# ---------- Python / Django ----------",
    "__pycache__/",
    "*.py[cod]",
    "*.sqlite3",
    "db.sqlite3",
    "*.pyo",
    "*.pyd",
    "*.egg-info/",
    ".pytest_cache/",
    ".mypy_cache/",

    "",

    "# ---------- Virtual Environment ----------",
    "venv/",
    "env/",
    ".venv/",

    "",

    "# ---------- Environment Variables ----------",
    ".env",
    ".env.local",
    ".env.development.local",
    ".env.test.local",
    ".env.production.local",

    "",

    "# ---------- VS Code ----------",
    ".vscode/",

    "",

    "# ---------- System Files ----------",
    ".DS_Store",
    "Thumbs.db",

    "",

    "# ---------- Static / Media ----------",
    "media/",
    "staticfiles/",

    "",

    "# ---------- Django Migrations Cache ----------",
    "*/migrations/*.pyc",

    "",

    "# ---------- TypeScript ----------",
    "*.tsbuildinfo",

    "",

    "# ---------- Temporary Files ----------",
    "*.swp",
    "*.swo",
    "*~"
  ]
}